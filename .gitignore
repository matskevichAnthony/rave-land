node_modules/
dist/

# Портативный Blender и веса моделей: качаются заново, в историю не нужны
_other/**/blender-*-linux-x64/
_other/**/venv/
_other/local-gen/weights/
_other/local-gen/models/

# Промежуточные .blend воспроизводятся скриптами пайплайна из исходных GLB
*.blend
*.blend1

# Сырой высокополигональный исходник до децимации
_other/bold-raver-rig/character-animated.glb

# Ассеты GTA San Andreas лежат в репозитории осознанно: он приватный и служит
# синхронизацией между машинами владельца. Перед любой публикацией проекта их
# и производные от них клипы надо вынести, см. F-041.

# Исключение из этого правила по размеру: gta3.img весит 897 МБ, папка audio 2.4 ГБ.
# Гигабайты в истории делают невозможным и клон, и любой push, а восстанавливаются они
# переносом с диска, а не git. Всё, что из них добыто (модели, звуки), в репозитории лежит,
# и любая добыча повторяется одной командой из tools/gta.
/gta3.img
/audio/
/GENRL

# Python-кеш
__pycache__/

# Прогоны генератора: сырой меш весит по 2.7 МБ на прогон, а всё это воспроизводится
# инструментами из tools/gen. В репозиторий едут только отобранные пропы.
public/assets/generated/

# Распакованный GENRL: 652 wav на 26 МБ, воспроизводятся из архива одной командой
# tools/gta/sfx.py. Опись index.csv и страница прослушивания остаются в истории.
_other/gta-sfx/bank*/
