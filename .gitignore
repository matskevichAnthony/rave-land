node_modules/
dist/

# Портативный Blender и веса моделей: качаются заново, в историю не нужны
_other/**/blender-*-linux-x64/
_other/**/venv/
_other/local-gen/weights/
_other/local-gen/models/

# Промежуточные .blend воспроизводятся скриптами пайплайна из исходных GLB
*.blend
*.blend1

# Сырой высокополигональный исходник до децимации
_other/bold-raver-rig/character-animated.glb

# Сырьё GTA San Andreas в репозиторий не едет: в рантайме из него не читается ни байта,
# а клон обязан подниматься одной командой. Переносится диском, любая добыча из него
# повторяется командой из tools/gta. Всё добытое (модели, звуки, клипы) лежит в
# public/assets и в истории остаётся; перед публикацией проекта производные от GTA
# надо вынести, см. F-041.
/gta3.img
/anim.img
/audio/
/GENRL
/Стандартная папка data/
/Стандартные анимации/
/Стандартный прицел и TXD/

# Исходники пайплайна персонажей: сырые модели, мокап и диагностические рендеры.
# Скрипты, описи и заметки рядом с ними в истории нужны, сотни мегабайт сырья нет:
# всё это входы и промежуточные шаги, а не то, что грузит страница.
_other/**/*.glb
_other/**/*.fbx
_other/**/*.bvh
_other/**/*.png

# Промежуточная сборка анимаций: пересобирается инструментом из tools/anim
tools/anim/build/

# Python-кеш
__pycache__/

# Прогоны генератора: сырой меш весит по 2.7 МБ на прогон, а всё это воспроизводится
# инструментами из tools/gen. В репозиторий едут только отобранные пропы.
public/assets/generated/

# Распакованные паки звуков: 8 тысяч wav на 350 МБ, воспроизводятся из audio/sfx
# командой tools/gta/sfx.py. Описи index.csv и страница прослушивания остаются в истории.
_other/gta-sfx/*/bank*/

# Дубликат клипов Dance из character-animated.glb, потребителя у него не осталось (F-008)
public/assets/models/dance-preview.glb
